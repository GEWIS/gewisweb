{% extends 'layout-sidebar.html.twig' %}

{% set current = company.currentRevision %}
{% set live = company.liveRevision %}

{% block page_title %}{{ 'Company profile'|trans|page_title }}{{ company.name|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ company.name }}{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'profile'} %}
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h3 class="mb-0">{{ 'Company profile'|trans }}</h3>
                <p class="text-muted mb-0">
                    {{ 'Changes go to your contact at GEWIS first; what is live stays live until they agree.'|trans }}
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                {% if current is not null and current.status.editableByAuthor %}
                    <a href="{{ path('company/profile/edit') }}" class="btn btn-gewis-primary">{{ 'Continue your draft'|trans }}</a>
                {% elseif current is not null and current.status.revisable %}
                    <form method="post" action="{{ path('company/profile/revise') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('company_profile_revise') }}">
                        <button type="submit" class="btn btn-gewis-primary">{{ 'Revise'|trans }}</button>
                    </form>
                {% endif %}
                {% if current is not null %}
                    <a href="{{ path('company/profile/status') }}" class="btn btn-outline-gewis-primary">{{ 'Status'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'What visitors see'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {% if live is null %}
                        <p class="text-muted mb-0">
                            {{ 'Nothing yet: your profile has not been approved, so your company is not shown on the website.'|trans }}
                        </p>
                    {% else %}
                        {% if live.logo is not null %}
                            <img class="career-logo-sm mb-3" style="object-fit: cover;" src="{{ image_url(live.logo, 'w320') }}" alt="">
                        {% endif %}
                        <dl class="row mb-0">
                            <dt class="col-sm-3">{{ 'Slogan'|trans }}</dt>
                            <dd class="col-sm-9">{{ live.slogan|localise_text }}</dd>
                            <dt class="col-sm-3">{{ 'Website'|trans }}</dt>
                            <dd class="col-sm-9">{{ live.website|localise_text }}</dd>
                            <dt class="col-sm-3">{{ 'Description'|trans }}</dt>
                            <dd class="col-sm-9 markdown">{{ live.description|localise_text|markdown }}</dd>
                            <dt class="col-sm-3">{{ 'Contact'|trans }}</dt>
                            <dd class="col-sm-9">
                                {{ live.contactName ?? '-' }}<br>
                                {{ live.contactEmail ?? '-' }}<br>
                                {{ live.contactPhone ?? '-' }}
                            </dd>
                        </dl>
                    {% endif %}
                </div>
            </div>
        </div>

        <aside class="col-md-4">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'What has happened'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <ul class="list-unstyled mb-0">
                        {% for entry in timeline %}
                            <li class="mb-2">
                                <div>{{ entry.verb.message(entry.actorDisplayName ?? 'The website'|trans, entry.detail)|trans }}</div>
                                <div class="text-muted small">
                                    {{ entry.createdAt|format_datetime(pattern: 'd MMM yyyy HH:mm', locale: app.request.locale) }}
                                </div>
                            </li>
                        {% else %}
                            <li class="text-muted small">{{ 'Nothing has happened yet.'|trans }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </aside>
    </div>
{% endblock %}
