{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Vacancies'|trans|page_title }}{{ company.name|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ company.name }}{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'vacancies'} %}
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h3 class="mb-0">{{ 'Your vacancies'|trans }}</h3>
                <p class="text-muted mb-0">
                    {{ 'A vacancy goes to your contact at GEWIS before it appears on the website.'|trans }}
                </p>
            </div>
            <a href="{{ path('company/vacancies/create') }}" class="btn btn-gewis-primary">
                <span class="fas fa-plus"></span> {{ 'Post a vacancy'|trans }}
            </a>
        </div>
    </div>

    <div class="panel">
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'Vacancy'|trans }}</th>
                            <th>{{ 'Category'|trans }}</th>
                            <th>{{ 'Status'|trans }}</th>
                            <th>{{ 'On the website'|trans }}</th>
                            <th>{{ 'Closes'|trans }}</th>
                            <th class="text-end">{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for vacancy in vacancies %}
                            {% set current = vacancy.currentRevision %}
                            <tr>
                                <td><strong>{{ current.name|localise_text }}</strong></td>
                                <td>
                                    <span class="badge {{ current.category.badgeClass }}">{{ current.category.label|trans }}</span>
                                </td>
                                <td>
                                    {% include 'partials/application/revision-status-badge.html.twig' with {
                                        'status': current.status,
                                        'live': current.liveCounterpart ? current.liveCounterpart.revisionNumber : null,
                                    } only %}
                                </td>
                                <td>
                                    {% if vacancy.isActive %}
                                        <span class="badge badge-success">{{ 'Live'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge-secondary">{{ 'Not shown'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted small">
                                    {{ current.endDate is not null ? current.endDate|date('j M Y') : '-' }}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('company/vacancies/status', {'vacancy': vacancy.id}) }}"
                                       class="btn btn-sm btn-outline-gewis-primary">{{ 'Open'|trans }}</a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    {{ 'You have not posted any vacancies yet.'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
