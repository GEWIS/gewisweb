{% extends 'layout.html.twig' %}

{% set company = dashboard.company %}

{% block page_title %}{{ 'Dashboard'|trans|page_title }}{{ company.name|page_title }}{{ parent() }}{% endblock %}

{% block pre_body %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_top %}
            <span class="page-header-eyebrow">{{ 'Company area'|trans }}</span>
        {% endblock %}
        {% block header_status %}
            {% if dashboard.company.liveRevision is not null %}
                <span class="badge badge-success">{{ 'Profile is live'|trans }}</span>
            {% else %}
                <span class="badge badge-secondary">{{ 'Profile is not live yet'|trans }}</span>
            {% endif %}
        {% endblock %}
        {% block header_title %}{{ dashboard.company.name }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'Everything you can do for your company on the GEWIS website.'|trans }}
            </p>
        {% endblock %}
        {% block header_actions %}
            <div class="d-flex flex-column gap-2">
                <a href="{{ path('company/vacancies/create') }}" class="btn btn-sm btn-outline-gewis-primary text-start">
                    <span class="fas fa-plus" aria-hidden="true"></span>
                    {{ 'Post a vacancy'|trans }}
                </a>
                <a href="{{ path('company/profile') }}" class="btn btn-sm btn-outline-gewis-primary text-start">
                    <span class="fas fa-building" aria-hidden="true"></span>
                    {{ 'Edit company profile'|trans }}
                </a>
                <a href="{{ path('company/vacancies') }}" class="btn btn-sm btn-outline-gewis-primary text-start">
                    <span class="fas fa-briefcase" aria-hidden="true"></span>
                    {{ 'Manage vacancies'|trans }}
                </a>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% macro tile(href, icon, label, description) %}
    <div class="col">
        <a href="{{ href }}" class="d-flex flex-column gap-2 border rounded p-3 text-body text-decoration-none h-100">
            <span class="fas {{ icon }}" aria-hidden="true"></span>
            <span>
                <span class="fw-semibold d-block">{{ label }}</span>
                <span class="small text-muted">{{ description }}</span>
            </span>
        </a>
    </div>
{% endmacro %}

{% macro attention(href, icon, title, description) %}
    <div class="col">
        <a href="{{ href }}" class="d-flex gap-3 border rounded p-3 text-body text-decoration-none h-100">
            <span class="fas {{ icon }} mt-1" aria-hidden="true"></span>
            <span>
                <span class="fw-semibold d-block">{{ title }}</span>
                <span class="small text-muted">{{ description }}</span>
            </span>
        </a>
    </div>
{% endmacro %}

{% block contents %}
    {% set needsAttention = dashboard.profileNeedsAttention
        or dashboard.drafts is not empty
        or dashboard.expiringPackages is not empty
        or dashboard.hasPendingBanner %}

    {% if needsAttention %}
        <div class="panel mt-0">
            <div class="panel-heading">
                <h3>{{ 'Needs your attention'|trans }}</h3>
            </div>
            <div class="panel-body">
                <div class="row row-cols-1 row-cols-md-2 g-2">
                    {% if dashboard.profileNeedsAttention %}
                        {{ _self.attention(
                            path('company/profile'),
                            'fa-building',
                            (dashboard.company.liveRevision is null)
                                ? 'Your profile is not on the website yet'|trans
                                : 'Your profile came back with changes requested'|trans,
                            (dashboard.company.liveRevision is null)
                                ? 'It has to be approved before visitors can see your company.'|trans
                                : 'Have a look at the feedback and send it back in.'|trans,
                        ) }}
                    {% endif %}
                    {% if dashboard.drafts is not empty %}
                        {{ _self.attention(
                            path('company/vacancies', {'filter': 'drafts'}),
                            'fa-pen',
                            '%count% unfinished draft|%count% unfinished drafts'|trans({'%count%': dashboard.drafts|length}),
                            'A draft only goes to GEWIS once you submit it for review.'|trans,
                        ) }}
                    {% endif %}
                    {% if dashboard.hasPendingBanner %}
                        {{ _self.attention(
                            path('company/banner'),
                            'fa-rectangle-ad',
                            'Your proposed banner is with GEWIS'|trans,
                            'It goes up once your contact has looked at it.'|trans,
                        ) }}
                    {% endif %}
                    {% for package in dashboard.expiringPackages %}
                        {{ _self.attention(
                            path('company/index'),
                            'fa-clock',
                            '%package% runs out on %date%'|trans({
                                '%package%': package.type.label|trans,
                                '%date%': package.expirationDate|date('j M Y'),
                            }),
                            'Get in touch with your contact at GEWIS to renew it.'|trans,
                        ) }}
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}

    <div class="panel {{ needsAttention ? '' : 'mt-0' }}">
        <div class="panel-heading d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h3>{{ 'Your vacancies'|trans }}</h3>
            <ul class="nav nav-pills nav-pills-compact" role="tablist">
                {% for filter, label in {
                    'all': 'All'|trans,
                    'live': 'Live'|trans,
                    'review': 'With GEWIS'|trans,
                    'drafts': 'Drafts'|trans,
                    'closed': 'Closed'|trans,
                } %}
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {% if 'all' == filter %}active{% endif %}"
                                id="dashboard-vacancies-{{ filter }}-tab"
                                data-bs-toggle="pill" data-bs-target="#dashboard-vacancies-{{ filter }}"
                                type="button" role="tab" aria-controls="dashboard-vacancies-{{ filter }}"
                                aria-selected="{{ 'all' == filter ? 'true' : 'false' }}">
                            {{ label }}
                            <span class="badge">{{ overview.counts[filter] }}</span>
                        </button>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <div class="panel-body">
            <div class="tab-content">
                {% for filter, vacancies in overview.groups %}
                    <div class="tab-pane fade {% if 'all' == filter %}show active{% endif %}"
                         id="dashboard-vacancies-{{ filter }}" role="tabpanel"
                         aria-labelledby="dashboard-vacancies-{{ filter }}-tab" tabindex="0">
                        {% include 'partials/career/company/vacancy-table.html.twig' with {
                            'vacancies': vacancies,
                            'emptyMessage': overview.counts.all > 0
                                ? 'Nothing in this list. Try another tab.'|trans
                                : 'You have not posted any vacancies yet.'|trans,
                        } only %}
                    </div>
                {% endfor %}
            </div>
            <a href="{{ path('company/vacancies') }}" class="d-inline-flex align-items-center gap-2 fw-semibold mt-2">
                {{ 'Manage all vacancies'|trans }}
                <span class="fas fa-arrow-right small" aria-hidden="true"></span>
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="panel mt-0">
                <div class="panel-heading">
                    <h3>{{ 'Manage your presence'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <div class="row row-cols-2 row-cols-md-3 g-2">
                        {{ _self.tile(path('company/profile'), 'fa-building', 'Company profile'|trans, 'Logo, story and contact'|trans) }}
                        {{ _self.tile(path('company/vacancies'), 'fa-briefcase', 'Vacancies'|trans, 'Post and edit openings'|trans) }}
                        {{ _self.tile(path('company/highlights'), 'fa-star', 'Highlights'|trans, 'Feature on the career page'|trans) }}
                        {{ _self.tile(path('company/banner'), 'fa-rectangle-ad', 'Banner'|trans, 'Your banner between the news items'|trans) }}
                        {{ _self.tile(path('company/representatives'), 'fa-user-group', 'Representatives'|trans, 'Who can sign in'|trans) }}
                        {{ _self.tile(path('company_user_security_index'), 'fa-shield-halved', 'Security'|trans, 'Password and sessions'|trans) }}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="panel mt-0">
                <div class="panel-heading">
                    <h3>{{ 'Your contract'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {% if dashboard.expiringPackages is empty %}
                        <p class="text-muted mb-0">{{ 'Nothing runs out in the next three months.'|trans }}</p>
                    {% else %}
                        <ul class="list-group">
                            {% for package in dashboard.expiringPackages %}
                                <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                    <span>{{ package.type.label|trans }}</span>
                                    <span class="text-muted small">
                                        {{ 'until %date%'|trans({'%date%': package.expirationDate|date('j M Y')}) }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                        <p class="text-muted small mt-2 mb-0">
                            {{ 'Get in touch with your contact at GEWIS to renew.'|trans }}
                        </p>
                    {% endif %}
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h3>{{ 'Representatives'|trans }}</h3>
                    <a href="{{ path('company/representatives') }}" class="small fw-semibold">{{ 'See all'|trans }}</a>
                </div>
                <div class="panel-body">
                    <p class="mb-0">
                        {{ '%count% person can act for your company.|%count% people can act for your company.'|trans({'%count%': dashboard.representatives}) }}
                    </p>
                    <p class="text-muted small mb-0">
                        {{ 'Ask your contact at GEWIS to add somebody or to shut somebody out.'|trans }}
                    </p>
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Your contact at GEWIS'|trans }}</h3>
                </div>
                <div class="panel-body">
                    <p class="fw-semibold mb-1">{{ 'Career Development and External Affairs Officer'|trans }}</p>
                    <p class="mb-2"><a href="mailto:{{ external_affairs_email }}">{{ external_affairs_email }}</a></p>
                    <p class="text-muted small mb-0">
                        {{ 'Questions about your profile, vacancies, banner or package all go here.'|trans }}
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
