{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Representatives'|trans|page_title }}{{ company.name|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ company.name }}{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'representatives'} %}
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_top %}
            <span class="page-header-eyebrow">{{ 'Company area'|trans }}</span>
        {% endblock %}
        {% block header_title %}{{ 'Representatives'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'Everybody who can act for %company% here. To add somebody, or to remove one of them, ask your contact at GEWIS.'|trans({'%company%': company.name}) }}
            </p>
        {% endblock %}
        {% block header_actions %}
            <a href="mailto:{{ external_affairs_email }}" class="btn btn-outline-gewis-primary">
                <span class="fas fa-envelope" aria-hidden="true"></span> {{ 'Email your contact at GEWIS'|trans }}
            </a>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8">
            <div class="panel mt-0">
                <div class="panel-body">
                    <ul class="list-group">
                        {% for representative in representatives %}
                            {% if not representative.disabled %}
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>
                                        <strong>{{ representative.name }}</strong>
                                        <code class="small">{{ representative.email }}</code>
                                        {% if representative is same as(me) %}
                                            <span class="text-muted small">({{ 'you'|trans }})</span>
                                        {% endif %}
                                    </span>
                                    {% if company.primaryContact is same as(representative) %}
                                        <span class="badge badge-info">{{ 'Primary contact'|trans }}</span>
                                    {% endif %}
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
