{% extends 'layout-sidebar.html.twig' %}

{% import 'partials/application/revision-diff.html.twig' as diffmacro %}

{% block page_title %}{{ revision.name|localise_text|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ vacancy.company.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>{{ diff_styles() }}</style>
{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'vacancies'} %}
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h3 class="mb-0">{{ revision.name|localise_text }}</h3>
                <p class="text-muted mb-0">
                    {{ 'Revision #%number%: %status%'|trans({
                        '%number%': revision.revisionNumber,
                        '%status%': revision.status|trans,
                    }) }}
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                {% if revision.status.editableByAuthor %}
                    <a href="{{ path('company/vacancies/edit', {'vacancy': vacancy.id}) }}"
                       class="btn btn-gewis-primary">{{ 'Keep editing'|trans }}</a>
                {% elseif revision.status.revisable %}
                    <form method="post" action="{{ path('company/vacancies/revise', {'vacancy': vacancy.id}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('company_vacancy_revise-' ~ vacancy.id) }}">
                        <button type="submit" class="btn btn-gewis-primary">{{ 'Revise'|trans }}</button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'What you changed'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {% if previous is null %}
                        <p class="text-muted">{{ 'This is your first version, so there is nothing to compare it against.'|trans }}</p>
                    {% endif %}
                    <div class="mb-3">
                        <h6 class="text-muted small mb-1">{{ 'Posting window'|trans }}</h6>
                        <div>
                            {{ revision.startDate is not null ? revision.startDate|date('j M Y') : 'on approval'|trans }}
                            &ndash;
                            {{ revision.endDate is not null ? revision.endDate|date('j M Y') : '-' }}
                        </div>
                    </div>
                    {% set dutch %}
                        {{ diffmacro.field_diff('Title'|trans, previous ? previous.name.valueNL : null, revision.name.valueNL) }}
                        {{ diffmacro.field_diff('Location'|trans, previous ? previous.location.valueNL : null, revision.location.valueNL) }}
                        {{ diffmacro.field_diff('Website'|trans, previous ? previous.website.valueNL : null, revision.website.valueNL) }}
                        {{ diffmacro.field_diff('Description'|trans, previous ? previous.description.valueNL : null, revision.description.valueNL, 'Inline') }}
                    {% endset %}
                    {% set english %}
                        {{ diffmacro.field_diff('Title'|trans, previous ? previous.name.valueEN : null, revision.name.valueEN) }}
                        {{ diffmacro.field_diff('Location'|trans, previous ? previous.location.valueEN : null, revision.location.valueEN) }}
                        {{ diffmacro.field_diff('Website'|trans, previous ? previous.website.valueEN : null, revision.website.valueEN) }}
                        {{ diffmacro.field_diff('Description'|trans, previous ? previous.description.valueEN : null, revision.description.valueEN, 'Inline') }}
                    {% endset %}
                    {{ diffmacro.language_columns(dutch, english) }}
                </div>
            </div>
        </div>

        <aside class="col-md-4">
            <div class="panel p-3">
                <h5>{{ 'What you can do'|trans }}</h5>
                {{ form_start(decisionForm, {'action': path('company/vacancies/decide', {'vacancy': vacancy.id})}) }}
                    {% if decisionForm.message is defined %}
                        {{ form_row(decisionForm.message) }}
                    {% endif %}
                    <div class="d-grid gap-2">
                        {% if decisionForm.submit is defined %}
                            {{ form_widget(decisionForm.submit, {'attr': {'class': 'btn btn-success'}}) }}
                        {% else %}
                            <p class="text-muted small mb-0">
                                {{ 'Nothing right now: this vacancy is with your contact at GEWIS.'|trans }}
                            </p>
                        {% endif %}
                    </div>
                {{ form_end(decisionForm) }}
                {% if canDiscard %}
                    <button type="button" class="btn btn-sm btn-outline-gewis-primary w-100 mt-2"
                            data-bs-toggle="modal" data-bs-target="#modal-discard-vacancy">
                        {{ 'Discard draft'|trans }}
                    </button>
                {% endif %}
            </div>

            {% include 'partials/application/revision-comments.html.twig' with {
                'comments': comments,
                'commentAction': path('company/vacancies/comment', {'vacancy': vacancy.id}),
                'csrfToken': csrf_token('company_vacancy_comment-' ~ vacancy.id),
                'audienceNote': 'Visible to you and your contact at GEWIS.'|trans,
            } only %}
        </aside>
    </div>

    {% if canDiscard %}
        <div class="modal fade" id="modal-discard-vacancy" tabindex="-1" aria-labelledby="modal-discard-vacancy-label" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modal-discard-vacancy-label">{{ 'Discard draft?'|trans }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <form method="post" action="{{ path('company/vacancies/discard', {'vacancy': vacancy.id}) }}">
                        <div class="modal-body">
                            <p class="mb-0">{{ 'The changes in this draft will be lost and your live vacancy restored.'|trans }}</p>
                        </div>
                        <div class="modal-footer">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('company_vacancy_discard-' ~ vacancy.id) }}">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                            <button type="submit" class="btn btn-gewis-primary">{{ 'Discard draft'|trans }}</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
