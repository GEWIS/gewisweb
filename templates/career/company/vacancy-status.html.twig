{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ revision.name|localise_text|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ vacancy.company.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>{{ diff_styles() }}</style>
{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'vacancies'} %}
{% endblock %}

{% block contents %}
    {% embed 'partials/application/review-screen.html.twig' with {
        'subjectName': revision.name|localise_text,
        'revision': revision,
        'previous': previous,
        'sections': sections,
        'comments': comments,
        'decisionForm': decisionForm,
        'canDiscard': canDiscard,
        'firstRevisionNote': 'This is your first version, so there is nothing to compare it against.'|trans,
        'mainWidth': 8,
        'asideWidth': 4,
        'actionsHeading': 'What you can do'|trans,
        'decideAction': path('company/vacancies/decide', {'vacancy': vacancy.id}),
        'decisionsEmptyNote': 'Nothing right now: this vacancy is with your contact at GEWIS.'|trans,
        'commentAction': path('company/vacancies/comment', {'vacancy': vacancy.id}),
        'commentToken': csrf_token('company_vacancy_comment-' ~ vacancy.id),
        'commentAudienceNote': 'Visible to you and your contact at GEWIS.'|trans,
        'discardAction': path('company/vacancies/discard', {'vacancy': vacancy.id}),
        'discardToken': csrf_token('company_vacancy_discard-' ~ vacancy.id),
        'discardBody': 'The changes in this draft will be lost and your live vacancy restored.'|trans,
    } only %}
        {% block review_header_actions %}
            {% if revision.status.editableByAuthor %}
                <a href="{{ path('company/vacancies/edit', {'vacancy': vacancy.id}) }}"
                   class="btn btn-gewis-primary">{{ 'Keep editing'|trans }}</a>
            {% elseif revision.status.revisable %}
                <form method="post" action="{{ path('company/vacancies/revise', {'vacancy': vacancy.id}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('company_vacancy_revise-' ~ vacancy.id) }}">
                    <button type="submit" class="btn btn-gewis-primary">{{ 'Revise'|trans }}</button>
                </form>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
