{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ (vacancy is null ? 'Post a vacancy'|trans : 'Edit your vacancy'|trans)|page_title }}{{ company.name|page_title }}{{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/ckeditor5/ckeditor5.css') }}">
{% endblock %}

{% block sidebar_label %}{{ company.name }}{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'vacancies'} %}
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12">
            <h3 class="mb-0">{{ vacancy is null ? 'Post a vacancy'|trans : 'Edit your vacancy'|trans }}</h3>
            <p class="text-muted mb-0">
                {{ 'Saving keeps this as a draft. It only appears on the website once the committee approves it.'|trans }}
            </p>
        </div>
    </div>
    {% set hasFeedback = comments is defined and comments is not empty %}
    <div class="row">
        <div class="{{ hasFeedback ? 'col-md-9' : 'col-md-12' }}">
            {# A vacancy being created has no id yet, so there is nothing to hold a lock on. #}
            {% if vacancy is not null %}
                <div data-controller="edit-lock"
                     data-edit-lock-ping-url-value="{{ path('company/vacancies/edit_ping', {'vacancy': vacancy.id}) }}"
                     data-edit-lock-release-url-value="{{ path('company/vacancies/edit_release', {'vacancy': vacancy.id}) }}"
                     data-edit-lock-csrf-token-value="{{ csrf_token('company_vacancy_edit_lock-' ~ vacancy.id) }}"
                     data-edit-lock-lost-message-value="{{ 'You no longer hold the edit lock; it was taken over or expired. Reload the page to continue editing.'|trans }}">
                    {% include 'partials/career/vacancy-form.html.twig' with {
                        'form': form,
                        'submitLabel': 'Save draft'|trans,
                        'cancelUrl': path('company/vacancies'),
                    } only %}
                </div>
            {% else %}
                {% include 'partials/career/vacancy-form.html.twig' with {
                    'form': form,
                    'submitLabel': 'Save draft'|trans,
                    'cancelUrl': path('company/vacancies'),
                } only %}
            {% endif %}
        </div>
        {% if hasFeedback %}
            <div class="col-md-3">
                {% include 'partials/application/review-feedback.html.twig' with {'comments': comments} only %}
            </div>
        {% endif %}
    </div>
{% endblock %}
