{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Banner'|trans|page_title }}{{ company.name|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ company.name }}{% endblock %}

{% block sidebar %}
    {% include 'partials/company-sidebar.html.twig' with {'activeRoute': 'banner'} %}
{% endblock %}

{% block page_header %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_container_class %}container-fluid px-3{% endblock %}
        {% block header_top %}
            <span class="page-header-eyebrow">{{ 'Company area'|trans }}</span>
        {% endblock %}
        {% block header_status %}
            {% if package is not null and package.hasPendingImage %}
                <span class="badge badge-info">{{ 'Waiting for a decision'|trans }}</span>
            {% elseif package is not null and package.image is not null %}
                <span class="badge badge-success">{{ 'On the website'|trans }}</span>
            {% endif %}
        {% endblock %}
        {% block header_title %}{{ 'Banner'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'Your banner runs between the news items on the home page and on the career page, so your contact at GEWIS looks at a new one before it goes up.'|trans }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    {% if package is null %}
        <div class="panel mt-0">
            <div class="panel-body">
                <span class="fas fa-rectangle-ad fa-2x text-muted d-block mb-3" aria-hidden="true"></span>
                <h4 class="mb-2">{{ 'You do not have a banner package'|trans }}</h4>
                <p class="text-muted mb-3">
                    {{ 'A banner runs between the news items on the GEWIS home page, so the whole association sees it and not only the students browsing vacancies. Ask your contact at GEWIS what a banner package would cost you.'|trans }}
                </p>
                <a href="mailto:{{ external_affairs_email }}" class="btn btn-gewis-primary">
                    {{ 'Email your contact at GEWIS'|trans }}
                </a>
            </div>
        </div>
    {% else %}
        {% include 'partials/career/banner-manage.html.twig' with {
            'package': package,
            'form': form,
            'canDecide': false,
            'submitLabel': 'Propose a banner'|trans,
            'formIntro': 'Your contact at GEWIS looks at what you upload before it goes onto the website. Until they do, the banner you already have stays where it is.'|trans,
        } only %}
    {% endif %}
{% endblock %}
