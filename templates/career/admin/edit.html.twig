{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ company.name|page_title }}{{ 'Edit'|trans|page_title }}{{ 'Career'|trans|page_title }}{{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/ckeditor5/ckeditor5.css') }}">
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/index') }}">{{ 'Career'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/companies/view', {'company': company.id}) }}">{{ company.name }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Edit'|trans }}</li>
{% endblock %}

{% block contents %}
    {% set hasFeedback = comments is defined and comments is not empty %}
    <div class="row">
        <div class="{{ hasFeedback ? 'col-md-9' : 'col-md-12' }}">
            <h3 class="mb-3">{{ 'Edit %company%'|trans({'%company%': company.name}) }}</h3>
            {% include 'partials/career/company-form.html.twig' with {
                'form': form,
                'submitLabel': 'Save changes'|trans,
                'cancelUrl': path('admin/career/companies/view', {'company': company.id}),
            } only %}
        </div>
        {% if hasFeedback %}
            <div class="col-md-3">
                {% include 'partials/application/review-feedback.html.twig' with {'comments': comments} only %}
            </div>
        {% endif %}
    </div>
{% endblock %}
