{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ subjectName|page_title }}{{ 'Review'|trans|page_title }}{{ 'Career'|trans|page_title }}{{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>{{ diff_styles() }}</style>
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/index') }}">{{ 'Career'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/approvals/index') }}">{{ 'Review'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ subjectName }}</li>
{% endblock %}

{% block contents %}
    {% include 'partials/application/review-screen.html.twig' with {
        'subjectName': subjectName,
        'revision': revision,
        'previous': previous,
        'sections': sections,
        'comments': comments,
        'decisionForm': decisionForm,
        'canDiscard': canDiscard,
        'showAuthor': true,
        'firstRevisionNote': 'This is the first revision; nothing to compare against.'|trans,
        'actionsHeading': 'Actions'|trans,
        'decideAction': path(decideRoute, {'revision': revision.getId}),
        'commentAction': path(commentRoute, {'revision': revision.getId}),
        'commentToken': csrf_token('career_review_comment-' ~ revision.getId),
        'commentAudienceNote': 'Visible to the company and the committee. Use it to ask a question or leave a note.'|trans,
        'discardAction': path(discardRoute, {'revision': revision.getId}),
        'discardToken': csrf_token('career_discard-' ~ revision.getId),
        'discardBody': 'The changes in this draft will be lost and the live version restored.'|trans,
    } only %}
{% endblock %}
