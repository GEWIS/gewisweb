{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Add a vacancy'|trans|page_title }}{{ 'Career'|trans|page_title }}{{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/ckeditor5/ckeditor5.css') }}">
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/vacancies/index') }}">{{ 'Vacancies'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Add'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-12">
            <h3 class="mb-3">{{ 'Add a vacancy'|trans }}</h3>
            {% include 'partials/career/vacancy-form.html.twig' with {
                'form': form,
                'submitLabel': 'Save draft'|trans,
                'cancelUrl': path('admin/career/vacancies/index'),
            } only %}
        </div>
    </div>
{% endblock %}
