{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Company is being edited'|trans|page_title }}{{ 'Career'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/index') }}">{{ 'Career'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Edit'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8">
            {% include 'partials/application/edit-lock-notice.html.twig' with {
                'lock': lock,
                'subject': 'this company'|trans,
                'backUrl': path('admin/career/companies/view', {'company': company.id}),
                'backLabel': 'Back to the company'|trans,
                'takeOverUrl': path('admin/career/companies/edit', {'company': company.id, 'take': 1}),
            } only %}
        </div>
    </div>
{% endblock %}
