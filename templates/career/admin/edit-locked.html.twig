{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Company is being edited'|trans|page_title }}{{ 'Career'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/career/index') }}">{{ 'Career'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Edit'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8">
            <div class="panel p-3">
                <h4>{{ 'This company is being edited'|trans }}</h4>
                <p>
                    {% if lock is not null %}
                        {{ '%name% is currently editing this company (last active %time%).'|trans({
                            '%name%': lock.holderDisplayName,
                            '%time%': lock.lastPingAt|format_datetime(pattern: 'HH:mm', locale: app.request.locale),
                        }) }}
                    {% else %}
                        {{ 'Someone is currently editing this company.'|trans }}
                    {% endif %}
                </p>
                <p class="text-muted small">{{ 'Try again once they are finished.'|trans }}</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('admin/career/companies/view', {'company': company.id}) }}" class="btn btn-secondary">
                        {{ 'Back to the company'|trans }}
                    </a>
                    {% if is_granted('ROLE_BOARD') %}
                        <a href="{{ path('admin/career/companies/edit', {'company': company.id, 'take': 1}) }}"
                           class="btn btn-outline-gewis-primary">
                            {{ 'Take over editing'|trans }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
