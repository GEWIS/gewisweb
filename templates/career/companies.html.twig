{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'Companies'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('career/index') }}">{{ 'Career'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Companies'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">{{ 'Companies'|trans }}</h2>

        {% include 'partials/filter-toggle.html.twig' with { target: 'company-filters' } only %}
    </div>

    {{ component('Career:CompanyOverview') }}
{% endblock %}
