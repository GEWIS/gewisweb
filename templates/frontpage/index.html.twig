{% extends 'layout.html.twig' %}

{% block pre_body %}
    <div class="container-fluid p-0 m-0 w-100 jumbotron home-hero">
        <img
            alt="{{ 'GEWIS room impression'|trans }}"
            src="{{ asset('images/panorama-960.webp') }}"
            srcset="{{ asset('images/panorama-320.webp') }} 320w,
            {{ asset('images/panorama-480.webp') }} 480w,
            {{ asset('images/panorama-640.webp') }} 640w,
            {{ asset('images/panorama-960.webp') }} 960w,
            {{ asset('images/panorama-1280.webp') }} 1280w,
            {{ asset('images/panorama-1920.webp') }} 1920w,
            {{ asset('images/panorama-2560.webp') }} 2560w,
            {{ asset('images/panorama-3840.webp') }} 3840w,
            {{ asset('images/panorama-4096.webp') }} 4096w,
            {{ asset('images/panorama-4480.webp') }} 4480w,
            {{ asset('images/panorama-5120.webp') }} 5120w"
            class="img-fluid">
        <div class="home-hero__overlay"></div>
        <div class="home-hero__content">
            <div class="container">
                <p class="home-hero__kicker mb-1">{{ 'Study Association GEWIS'|trans }}</p>
                <h1 class="display-6 fw-bold mb-2">
                    {{ 'The association of Mathematics & Computer Science at TU/e'|trans }}
                </h1>
                <p class="mb-3">{{ 'Everything happening around the association: news, activities and photos.'|trans }}</p>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('activity/index') }}" class="btn btn-gewis-primary">
                        <span class="far fa-calendar"></span> {{ 'Upcoming activities'|trans }}
                    </a>
                    <a href="{{ page_path(
                        category: 'vereniging',
                        categoryEn: 'association',
                        sub_category: 'lid-worden',
                        sub_categoryEn: 'become-member',
                    ) }}" class="btn btn-outline-light">
                        <span class="fas fa-door-open"></span> {{ 'Become a member'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block contents %}
    <div class="row">
        <main class="col-sm-7 col-md-8">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h2 class="h5 text-uppercase text-primary-emphasis mb-0">{{ 'News'|trans }}</h2>
                <a href="{{ path('news/index') }}" class="ms-auto small fw-bold">
                    {{ 'All posts'|trans }} <span class="fas fa-arrow-right"></span>
                </a>
            </div>

            {% if newsFeed is empty %}
                <div class="panel">
                    <div class="panel-body">
                        <p class="text-muted mb-0">{{ 'There is no news here yet.'|trans }}</p>
                    </div>
                </div>

                {% include 'partials/career/banner-strip.html.twig' with {'banners': company_banners()} only %}
            {% else %}
                {% set pinned = newsFeed|filter(item => item.pinned) %}
                {% set regular = newsFeed|filter(item => not item.pinned) %}

                {% for item in pinned %}
                    {% include 'partials/frontpage/news-pinned.html.twig' with {'item': item} %}
                {% endfor %}

                {# The banners sit in the feed rather than under it. They follow what the board pinned, and where
                   nothing is pinned they come after the second item. #}
                {% set adAfter = pinned is empty ? min(2, regular|length) : 0 %}
                {% if 0 == adAfter %}
                    {% include 'partials/career/banner-strip.html.twig' with {'banners': company_banners()} only %}
                {% endif %}

                {% for item in regular %}
                    <div class="panel">
                        <div class="panel-body">
                            {% include 'partials/frontpage/news-item.html.twig' with {'item': item} %}
                        </div>
                    </div>

                    {% if loop.index == adAfter %}
                        {% include 'partials/career/banner-strip.html.twig' with {'banners': company_banners()} only %}
                    {% endif %}
                {% endfor %}

                <div class="d-flex justify-content-center">
                    <a href="{{ path('news/index') }}" class="btn btn-outline-secondary">
                        {{ 'Older posts'|trans }} <span class="fas fa-arrow-down"></span>
                    </a>
                </div>
            {% endif %}
        </main>

        <aside class="col-sm-5 col-md-4 ps-md-5">
            <div class="panel">
                <div class="panel-heading">
                    <h3>{{ 'Agenda'|trans }}</h3>
                </div>
                {% if activities is not empty %}
                    <div class="panel-body pb-0">
                        {% for activity in activities %}
                            {% include 'partials/activity/agenda-item.html.twig' with {'activity': activity} only %}
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="panel-body">
                    <small>
                        {% trans with {'%link_start%': '<a href="https://bac.gewis.nl">', '%link_end%': '</a>'} %}
                            On Thursdays, there is a %link_start%social drink%link_end% from 16.30 to 19.00.
                        {% endtrans %}
                    </small>
                </div>
                <div class="panel-footer">
                    <a href="{{ path('activity/index') }}" class="panel-footer-link">
                        {{ 'Complete agenda'|trans }}
                    </a>
                    <a
                        href="https://www.google.com/calendar/embed?src=v23gq10ij44fhdsfdof1s613ak%40group.calendar.google.com&gsessionid=OK"
                        title="{{ 'Google Calendar'|trans }}"
                        class="panel-footer-link"
                    >
                        {{ 'iCal'|trans }}
                    </a>
                </div>
            </div>

            {#
                The photo of the week. Members fetch the signed members-only original; anonymous visitors are served the
                public copy the weekly command publishes, and only while it is not hidden.
            #}
            {% if weeklyPhoto is not null and (is_granted('ROLE_USER') or (not weeklyPhoto.hidden and weeklyPublicPath is not null)) %}
                {% set potw = weeklyPhoto.photo %}
                {% set potw_url = path('photo/album', { type: 'album', album: potw.album.id }) ~ '#pid=' ~ potw.id %}
                {% set potw_path = is_granted('ROLE_USER') ? potw.path : weeklyPublicPath %}
                <div class="panel">
                    <div class="panel-heading">
                        <h3><a href="{{ potw_url }}">{{ 'Photo of the Week'|trans }}</a></h3>
                    </div>
                    <div class="panel-thumb">
                        <a href="{{ potw_url }}">
                            <img class="img-fluid" alt=""
                                 src="{{ image_url(potw_path, 'w320') }}"
                                 srcset="{{ image_srcset(potw_path, ['w320', 'w640']) }}"
                                 sizes="(min-width: 992px) 320px, 100vw">
                        </a>
                    </div>
                </div>
            {% endif %}

            {# Birthday data is member-only, so the block is gated on an authenticated session. #}
            {% if birthdays is not empty and is_granted('ROLE_USER') %}
                {% include 'partials/frontpage/birthdays-panel.html.twig' with {
                    'birthdays': birthdays,
                    'birthdayTags': birthdayTags,
                } only %}
            {% endif %}

            {% if currentPoll is not null %}
                {{ component('Frontpage:PollWidget', {'poll': currentPoll}) }}
            {% endif %}

            {# The infimum is a members-only thing, and the topic it rotates over is subscribed to on the same terms. #}
            {% if is_granted('ROLE_USER') %}
                {% include 'partials/frontpage/infimum-panel.html.twig' only %}
            {% endif %}
        </aside>
    </div>
{% endblock %}
