{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'News'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'News'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">{{ 'News'|trans }}</h2>

        <div class="d-flex flex-wrap align-items-center gap-2">
            {% include 'partials/filter-toggle.html.twig' with { target: 'news-filters' } only %}

            {% include 'partials/year-switcher.html.twig' with {
                route: 'news/index',
                year: year,
                years: years,
            } only %}
        </div>
    </div>

    {{ component('Frontpage:NewsOverview', { year: year, category: category }) }}
{% endblock %}
