{% extends 'layout.html.twig' %}

{% set title = item.title %}
{% set body = item.content %}

{% block page_title %}{{ title|page_title }}{{ 'News'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('news/index') }}">{{ 'News'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ title }}</li>
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8">
            <div class="panel">
                <div class="panel-heading">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <a class="badge {{ item.category.badgeClass }}"
                           href="{{ path('news/index', {'category': item.category.value}) }}">{{ item.category|trans }}</a>
                        <span class="text-muted small">{{ item.date|format_date(pattern: 'd MMMM yyyy', locale: app.request.locale) }}</span>
                    </div>
                    <h2>{{ title }}</h2>
                </div>
                <div class="panel-body">
                    {{ body|markdown }}
                </div>
                <div class="panel-footer">
                    <a href="{{ path('news/index') }}">
                        <span class="fas fa-arrow-left"></span> {{ 'All news'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
