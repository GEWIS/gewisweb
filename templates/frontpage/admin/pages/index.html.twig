{% extends 'layout-admin.html.twig' %}
{% import 'partials/application/confirm-post-modal.html.twig' as modals %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ 'Pages'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/frontpage/pages/index') }}">{{ 'Pages'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Overview'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="mb-0">{{ 'Pages'|trans }}</h2>
            <a href="{{ path('admin/frontpage/pages/create') }}" class="btn btn-gewis-primary">
                <span class="fas fa-plus"></span> {{ 'New page'|trans }}
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-body">
                    {% if pages is empty %}
                        <p class="text-muted mb-0">{{ 'There are no pages yet.'|trans }}</p>
                    {% else %}
                        {# The pages arrive sorted by address, so a page sits directly under the one it lives beneath
                           and the depth of its own address is all the indent needs. #}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'Address'|trans }}</th>
                                        <th>{{ 'Title'|trans }}</th>
                                        <th>{{ 'Who may read this page'|trans }}</th>
                                        <th>{{ 'Last edited'|trans }}</th>
                                        <th class="text-end">{{ 'Actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for customPage in pages %}
                                        {% set address = [
                                            customPage.category|localise_text,
                                            customPage.subCategory|localise_text,
                                            customPage.name|localise_text,
                                        ]|filter(part => part is not empty) %}
                                        <tr>
                                            <td>
                                                <span class="page-tree{{ address|length > 1 ? ' page-tree--nested' }}"
                                                      style="--page-tree-depth: {{ address|length - 1 }}">
                                                    <code title="/{{ address|join('/') }}">{{ address|last }}</code>
                                                </span>
                                            </td>
                                            <td>
                                                <a href="{{ path('admin/frontpage/pages/edit', {'page': customPage.id}) }}">
                                                    {{ customPage.title|localise_text }}
                                                </a>
                                            </td>
                                            <td class="text-muted small">{{ customPage.requiredRole.label|trans }}</td>
                                            <td class="text-muted small">{{ relative_time(customPage.updatedAt) }}</td>
                                            <td class="text-end">
                                                <a href="{{ path('admin/frontpage/pages/edit', {'page': customPage.id}) }}"
                                                   class="btn btn-sm btn-outline-gewis-primary">{{ 'Edit'|trans }}</a>
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modal-delete-page-{{ customPage.id }}">
                                                    {{ 'Delete'|trans }}
                                                </button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% for customPage in pages %}
        {{ modals.confirm_modal(
            'modal-delete-page-' ~ customPage.id,
            path('admin/frontpage/pages/delete', {'page': customPage.id}),
            csrf_token('page_delete-' ~ customPage.id),
            'Delete this page?'|trans,
            'The page and everything on it disappear from the website. This cannot be undone.'|trans,
            'Delete'|trans,
            'danger',
        ) }}
    {% endfor %}
{% endblock %}
