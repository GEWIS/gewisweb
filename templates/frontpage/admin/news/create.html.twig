{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Write news'|trans|page_title }}{{ 'News'|trans|page_title }}{{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# The markdown editor draws itself with this; without it the toolbar and the editing area render unstyled. #}
    <link rel="stylesheet" href="{{ asset('styles/ckeditor5/ckeditor5.css') }}">
{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/frontpage/news/index') }}">{{ 'News'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Write news'|trans }}</li>
{% endblock %}

{% block contents %}
    <h2 class="mb-3">{{ 'Write news'|trans }}</h2>
    {% include 'frontpage/admin/news/_form.html.twig' %}
{% endblock %}
