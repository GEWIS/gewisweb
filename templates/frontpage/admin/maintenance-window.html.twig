{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'New window'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/maintenance') }}">{{ 'Maintenance'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'New window'|trans }}
    </li>
{% endblock %}

{% block contents %}
    <div class="row justify-content-center">
        <div class="col col-lg-9 col-xl-8">
            <div class="panel">
                <div class="panel-heading">
                    <h3 class="mb-0">{{ 'Schedule maintenance'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Leave the start empty to begin at once, and the end empty to keep it on until you turn it off. Windows may not overlap.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.status) }}
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.startsAt) }}</div>
                        <div class="col-md-6">{{ form_row(form.endsAt) }}</div>
                    </div>
                    <div class="mt-3 d-flex justify-content-end">
                        <button type="submit" class="btn btn-gewis-primary">
                            {{ 'Schedule'|trans }}
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
