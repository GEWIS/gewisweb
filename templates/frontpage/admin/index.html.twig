{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ parent() }}{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="mb-1">{{ 'Administration'|trans }}</h2>
            <p class="text-muted mb-0">
                {% if totalCount == 0 %}
                    {{ 'Nothing is waiting on you right now.'|trans }}
                {% else %}
                    {{ '%count% item is waiting for a decision|%count% items are waiting for a decision'|trans({
                        '%count%': totalCount,
                    }) }}{% if oldest is not null %} &middot;
                        {{ 'oldest %duration%'|trans({'%duration%': relative_time(oldest)}) }}
                    {% endif %}
                {% endif %}
            </p>
        </div>

        {% if showsAdministration %}
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('admin/maintenance') }}" class="btn btn-outline-secondary">
                    <span class="fas fa-screwdriver-wrench"></span> {{ 'Maintenance'|trans }}
                </a>
                <a href="{{ path('admin/announcement') }}" class="btn btn-gewis-primary">
                    <span class="fas fa-bullhorn"></span> {{ 'Announcements'|trans }}
                </a>
            </div>
        {% endif %}
    </div>

    <div class="row">
        <div class="col-lg-8">
            {% if queues is empty %}
                <div class="panel mt-0">
                    <div class="panel-body">
                        <p class="text-muted mb-0">
                            {{ 'There is nothing here waiting on you. What you can do is in the menu on the left.'|trans }}
                        </p>
                    </div>
                </div>
            {% else %}
                <div class="panel mt-0">
                    <div class="panel-heading d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <h3>{{ 'Waiting on you'|trans }}</h3>
                        <ul class="nav nav-pills nav-pills-compact">
                            <li class="nav-item">
                                <a class="nav-link {{ selected is null ? 'active' }}" href="{{ path('admin/index') }}">
                                    {{ 'Everything'|trans }}
                                    <span class="badge">{{ totalCount }}</span>
                                </a>
                            </li>
                            {% for summary in queues %}
                                <li class="nav-item">
                                    <a class="nav-link {{ selected is not null and selected.key == summary.key ? 'active' }}"
                                       href="{{ path('admin/index', {'queue': summary.key}) }}">
                                        {{ summary.name|trans }}
                                        <span class="badge">{{ summary.rows|length }}</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    {% if waiting is empty %}
                        <div class="panel-body text-center py-4">
                            <p class="fw-semibold mb-1">{{ 'Nothing waiting here'|trans }}</p>
                            <p class="text-muted small mb-0">
                                {{ 'Pick another area above, or come back later.'|trans }}
                            </p>
                        </div>
                    {% else %}
                        <div class="panel-body table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'Item'|trans }}</th>
                                        <th>{{ 'Proposed by'|trans }}</th>
                                        <th>{{ 'Waiting'|trans }}</th>
                                        <th class="text-end">{{ 'Action'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for item in waiting %}
                                        {% set row = item.row %}
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">{{ row.subject }}</div>
                                                <span class="badge badge-tag">
                                                    <span class="fas {{ item.queue.icon }}" aria-hidden="true"></span>
                                                    {{ item.queue.name|trans }}
                                                </span>
                                                <span class="text-muted small ms-1">
                                                    {{ 'Revision %number%'|trans({'%number%': row.revisionNumber}) }}
                                                    {%- if row.liveRevisionNumber is not null %},
                                                        {{ 'live %number%'|trans({'%number%': row.liveRevisionNumber}) }}
                                                    {%- endif %}
                                                </span>
                                            </td>
                                            <td class="text-muted small">{{ row.author ?: 'Removed account'|trans }}</td>
                                            <td>
                                                <span class="badge badge-{{ row.waitingBadgeClass }}">
                                                    {{ relative_time(row.submittedAt) }}
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <a href="{{ path(row.reviewRoute, {'revision': row.revisionId}) }}"
                                                   class="btn btn-sm btn-outline-gewis-primary">{{ 'Review'|trans }}</a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <div class="panel-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="text-muted small">
                            {{ 'Showing %shown% of %total% open items'|trans({
                                '%shown%': waiting|length,
                                '%total%': waitingCount,
                            }) }}
                        </span>
                        {% if selected is not null %}
                            <a href="{{ path(selected.queueRoute) }}" class="panel-footer-link">
                                {{ 'Open the full queue'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        <aside class="col-lg-4">
            {% if showsAdministration %}
                <div class="panel mt-0">
                    <div class="panel-heading">
                        <h3>{{ 'Site state'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        <div class="d-flex align-items-start gap-2 pb-2">
                            <span class="fas fa-bullhorn text-muted mt-1" aria-hidden="true"></span>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">{{ 'Announcements'|trans }}</div>
                                {% if announcements is empty %}
                                    <span class="small text-muted">
                                        {{ 'Nothing is being announced at the moment.'|trans }}
                                    </span>
                                {% else %}
                                    <ul class="list-unstyled small mb-0">
                                        {% for announcement in announcements %}
                                            <li>
                                                <span class="badge badge-{{ announcement.level.value }}">
                                                    {{ announcement.level|trans }}
                                                </span>
                                                {{ announcement.title|localise_text }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                            <a href="{{ path('admin/announcement') }}" class="small fw-semibold">
                                {{ 'Manage'|trans }}
                            </a>
                        </div>
                        <div class="d-flex align-items-start gap-2 pt-2 border-top">
                            <span class="fas fa-screwdriver-wrench text-muted mt-1" aria-hidden="true"></span>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">{{ 'Maintenance'|trans }}</div>
                                <span class="small text-muted">{{ maintenance|trans }}</span>
                            </div>
                            <a href="{{ path('admin/maintenance') }}" class="small fw-semibold">
                                {{ 'Manage'|trans }}
                            </a>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="panel {{ showsAdministration ? '' : 'mt-0' }}">
                <div class="panel-body">
                    <p class="fw-semibold mb-1">{{ 'Missing an area?'|trans }}</p>
                    <p class="text-muted small mb-0">
                        {{ 'What you can reach here follows the body you are in. The board changes who may do what.'|trans }}
                    </p>
                </div>
            </div>
        </aside>
    </div>
{% endblock %}
