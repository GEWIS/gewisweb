{% extends 'layout-admin.html.twig' %}
{% import 'partials/application/confirm-post-modal.html.twig' as modals %}

{% block page_title %}{{ 'Overview'|trans|page_title }}{{ 'Polls'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/frontpage/polls/index') }}">{{ 'Polls'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Overview'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 class="mb-0">{{ 'Polls'|trans }}</h2>
            <a href="{{ path('admin/frontpage/polls/approvals/index') }}" class="btn btn-outline-gewis-primary">
                {{ 'Awaiting review'|trans }}
                <span class="badge badge-gewis-primary">{{ awaitingReview }}</span>
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel">
                <div class="panel-body">
                    {% if polls|length == 0 %}
                        <p class="text-muted mb-0">{{ 'No poll has been agreed to yet.'|trans }}</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'Question'|trans }}</th>
                                        <th>{{ 'Closes on'|trans }}</th>
                                        <th>{{ 'Votes'|trans }}</th>
                                        <th>{{ 'Status'|trans }}</th>
                                        <th class="text-end">{{ 'Actions'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for poll in polls %}
                                        <tr>
                                            <td>
                                                <a href="{{ path('poll/view', {'poll': poll.id}) }}">
                                                    {{ poll.question|localise_text }}
                                                </a>
                                            </td>
                                            <td class="text-muted small">{{ poll.expiryDate|format_date(pattern: 'd MMM yyyy', locale: app.request.locale) }}</td>
                                            <td class="text-muted small">{{ poll.totalVotesCount }}</td>
                                            <td>
                                                {% if poll.isActive %}
                                                    <span class="badge badge-success">{{ 'Running'|trans }}</span>
                                                {% else %}
                                                    <span class="badge badge-secondary">{{ 'Closed'|trans }}</span>
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                {% if poll.isActive %}
                                                    <button type="button" class="btn btn-sm btn-outline-gewis-primary"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#modal-close-poll-{{ poll.id }}">
                                                        {{ 'Close now'|trans }}
                                                    </button>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% for poll in polls %}
        {% if poll.isActive %}
            {{ modals.confirm_modal(
                'modal-close-poll-' ~ poll.id,
                path('admin/frontpage/polls/delete', {'poll': poll.id}),
                csrf_token('poll_delete-' ~ poll.id),
                'Close this poll now?'|trans,
                'The poll stops taking answers today. The question and the answers it was given stay in the archive.'|trans,
                'Close now'|trans,
                'gewis-primary',
            ) }}
        {% endif %}
    {% endfor %}
{% endblock %}
