{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'Polls'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Polls'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <h2 class="mb-1">{{ 'The poll archive'|trans }}</h2>
            <p class="text-muted mb-0">
                {{ 'Every question the association has been asked, and how it answered.'|trans }}
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            {% include 'partials/filter-toggle.html.twig' with { target: 'poll-filters' } only %}

            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('poll/request') }}" class="btn btn-gewis-primary">
                    <span class="fas fa-plus"></span> {{ 'Request a poll'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {# Outside the archive component: the poll that is running is the same one whatever the reader searches for. #}
    {% if current is not null %}
        <div class="poll-hero panel mb-3">
            <div class="panel-body">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge badge-success">
                        <span class="fas fa-circle" aria-hidden="true"></span> {{ 'Voting now'|trans }}
                    </span>
                    <span class="poll-hero__meta small">
                        {{ 'Closes on %date%'|trans({'%date%': current.expiryDate|format_date(pattern: 'd MMMM yyyy', locale: app.request.locale)}) }}
                        &middot;
                        {{ '%count% vote|%count% votes'|trans({'%count%': current.totalVotesCount}) }}
                    </span>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <h3 class="poll-hero__question mb-0">{{ current.question|localise_text }}</h3>
                    <a class="btn btn-gewis-primary ms-auto" href="{{ path('poll/view', {'poll': current.id}) }}">
                        {{ 'Cast your vote'|trans }} <span class="fas fa-arrow-right"></span>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    {{ component('Frontpage:PollArchive') }}
{% endblock %}
