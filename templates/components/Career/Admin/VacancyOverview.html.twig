<div {{ attributes }}>
    <div class="panel mb-3">
        <div class="panel-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-{{ this.pinnedToACompany ? 6 : 3 }}">
                    <label class="form-label" for="career-vacancy-overview-search">{{ 'Search'|trans }}</label>
                    <input type="search" class="form-control" id="career-vacancy-overview-search"
                           placeholder="{{ 'Search by title or slug'|trans }}"
                           data-model="debounce(300)|search"
                           value="{{ this.search }}">
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="career-vacancy-overview-status">{{ 'Status'|trans }}</label>
                    <select class="form-select" id="career-vacancy-overview-status" data-model="status">
                        <option value="">{{ 'Any status'|trans }}</option>
                        {% for case in this.statuses %}
                            <option value="{{ case.value }}"{% if this.status == case.value %} selected{% endif %}>
                                {{ case|trans }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="career-vacancy-overview-category">{{ 'Category'|trans }}</label>
                    <select class="form-select" id="career-vacancy-overview-category" data-model="category">
                        <option value="">{{ 'Any category'|trans }}</option>
                        {% for case in this.categories %}
                            <option value="{{ case.value }}"{% if this.category == case.value %} selected{% endif %}>
                                {{ case.label|trans }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                {% if not this.pinnedToACompany %}
                    <div class="col-md-3">
                        <label class="form-label" for="career-vacancy-overview-company">{{ 'Company'|trans }}</label>
                        <select class="form-select" id="career-vacancy-overview-company" data-model="companyFilter">
                            <option value="">{{ 'Any company'|trans }}</option>
                            {% for id, name in this.companies %}
                                <option value="{{ id }}"{% if this.companyFilter == id %} selected{% endif %}>
                                    {{ name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'Vacancy'|trans }}</th>
                            {% if not this.pinnedToACompany %}
                                <th>{{ 'Company'|trans }}</th>
                            {% endif %}
                            <th>{{ 'Category'|trans }}</th>
                            <th>{{ 'Status'|trans }}</th>
                            <th>{{ 'Closes'|trans }}</th>
                            <th class="text-end">{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for vacancy in this.vacancies %}
                            {% set current = vacancy.currentRevision %}
                            <tr>
                                <td>
                                    <strong>{{ current.name|localise_text }}</strong>
                                    <div class="text-muted small"><code>{{ vacancy.slugName }}</code></div>
                                </td>
                                {% if not this.pinnedToACompany %}
                                    <td>
                                        <a href="{{ path('admin/career/companies/view', {'company': vacancy.company.id}) }}">
                                            {{ vacancy.company.name }}
                                        </a>
                                    </td>
                                {% endif %}
                                <td>
                                    <span class="badge {{ current.category.badgeClass }}">{{ current.category.label|trans }}</span>
                                </td>
                                <td>
                                    {% include 'partials/application/revision-status-badge.html.twig' with {
                                        'status': current.status,
                                        'live': current.liveCounterpart ? current.liveCounterpart.revisionNumber : null,
                                    } only %}
                                </td>
                                <td class="text-muted small">
                                    {{ current.endDate is not null ? current.endDate|date('j M Y') : '-' }}
                                </td>
                                <td class="text-end">
                                    {% if current.status.editableByAuthor %}
                                        <a href="{{ path('admin/career/vacancies/edit', {'vacancy': vacancy.id}) }}"
                                           class="btn btn-sm btn-outline-gewis-primary">{{ 'Edit'|trans }}</a>
                                        <a href="{{ path('admin/career/approvals/vacancy', {'revision': current.id}) }}"
                                           class="btn btn-sm btn-outline-success">{{ 'Submit for review'|trans }}</a>
                                    {% elseif current.status.revisable %}
                                        <form method="post" action="{{ path('admin/career/vacancies/revise', {'vacancy': vacancy.id}) }}">
                                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('vacancy_revise-' ~ vacancy.id) }}">
                                            <button type="submit" class="btn btn-sm btn-outline-gewis-primary">
                                                {{ 'Revise'|trans }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ this.pinnedToACompany ? 5 : 6 }}" class="text-center text-muted py-4">
                                    {{ 'No vacancies match the current filters.'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% include 'partials/application/pagination.html.twig' with {
                'page': this.page,
                'totalPages': this.totalPages,
                'totalCount': this.totalCount,
                'pageSize': this.pageSize,
            } only %}
        </div>
    </div>
</div>
