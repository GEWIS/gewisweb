<div {{ attributes }}>
    <div class="panel mb-3">
        <div class="panel-body">
            <label class="form-label" for="career-company-overview-search">{{ 'Search'|trans }}</label>
            <input type="search" class="form-control" id="career-company-overview-search"
                   placeholder="{{ 'Search by name or slug'|trans }}"
                   data-model="debounce(300)|search"
                   value="{{ this.search }}">
        </div>
    </div>

    <div class="panel">
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'Company'|trans }}</th>
                            <th>{{ 'Profile'|trans }}</th>
                            <th>{{ 'Visibility'|trans }}</th>
                            <th>{{ 'Packages'|trans }}</th>
                            <th class="text-end">{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for company in this.companies %}
                            <tr>
                                <td>
                                    <strong>{{ company.name }}</strong>
                                    <div class="text-muted small"><code>{{ company.slugName }}</code></div>
                                </td>
                                <td>
                                    {% if company.currentRevision is not null %}
                                        {% include 'partials/application/revision-status-badge.html.twig' with {
                                            'status': company.currentRevision.status,
                                        } only %}
                                    {% else %}
                                        <span class="text-muted small">{{ 'None'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if company.hidden %}
                                        <span class="badge badge-secondary">{{ 'Not shown'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge-success">{{ 'Shown'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td class="text-muted small">
                                    {{ 'active'|trans }}: {{ company.numberOfPackages - company.numberOfExpiredPackages }}
                                    / {{ company.numberOfPackages }}
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('admin/career/companies/view', {'company': company.id}) }}"
                                       class="btn btn-sm btn-outline-secondary">{{ 'View'|trans }}</a>
                                    {% if company.currentRevision is not null and company.currentRevision.status.editableByAuthor %}
                                        <a href="{{ path('admin/career/approvals/company', {'revision': company.currentRevision.id}) }}"
                                           class="btn btn-sm btn-outline-success">{{ 'Submit for review'|trans }}</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    {{ 'No companies match the current search.'|trans }}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% include 'partials/application/pagination.html.twig' with {
                'page': this.page,
                'totalPages': this.totalPages,
                'totalCount': this.totalCount,
                'pageSize': this.pageSize,
            } only %}
        </div>
    </div>
</div>
