{% extends 'layout-sidebar.html.twig' %}

{% block page_title %}{{ 'Administration'|trans|page_title }}{{ parent() }}{% endblock %}

{% block sidebar_label %}{{ 'Administration'|trans }}{% endblock %}

{% block sidebar %}
    {% include 'partials/admin-sidebar.html.twig' %}
{% endblock %}

{% block sidebar_footer %}
    {% set commit = app.request.server.get('GIT_COMMIT') %}
    <a href="https://github.com/gewis/gewisweb/commit/{{ commit }}" target="_blank">
        <span class="fab fa-github" aria-hidden="true"></span> {{ commit|slice(0, 7) }}
    </a>
{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        <a href="{{ path('admin/index') }}">
            {{ 'Admin'|trans }}
        </a>
    </li>
    {% block admin_breadcrumbs %}{% endblock %}
{% endblock %}
