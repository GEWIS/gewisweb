{% import 'partials/application/sidebar.html.twig' as sidebar %}

{{ sidebar.context(
    member.firstName|slice(0, 1) ~ member.lastName|slice(0, 1),
    member.fullName,
    'Generation %year%'|trans({'%year%': member.generation}),
) }}

<ul class="sidebar-list">
    {{ sidebar.link(
        isSelf ? path('members/me') : path('members/view', {'member': member.lidnr}),
        'fa-user',
        'Overview'|trans,
        'overview' == activeRoute,
    ) }}
    {{ sidebar.link(
        path('photo/album', {'type': 'member', 'album': member.lidnr}),
        'fa-image',
        'Photos'|trans,
        'photos' == activeRoute,
    ) }}
</ul>

{% if isSelf %}
    <div>
        {{ sidebar.group('Settings'|trans) }}
        <ul class="sidebar-list">
            {{ sidebar.link(path('user_settings_index'), 'fa-sliders', 'General'|trans, 'general' == activeRoute) }}
            {{ sidebar.link(path('user_settings_notifications'), 'fa-bell', 'Notifications'|trans, 'notifications' == activeRoute) }}
            {{ sidebar.link(path('user_settings_privacy'), 'fa-user-shield', 'Privacy'|trans, 'privacy' == activeRoute) }}
            {{ sidebar.link(path('user_security_index'), 'fa-shield-halved', 'Security'|trans, 'security' == activeRoute) }}
        </ul>
    </div>
{% endif %}
