{% import 'partials/application/sidebar.html.twig' as sidebar %}

{% set company = app.user.company %}
{{ sidebar.context(company.name|slice(0, 1), company.name, 'Company area'|trans) }}

<ul class="sidebar-list">
    {{ sidebar.link(path('company/index'), 'fa-gauge-high', 'Dashboard'|trans, 'overview' == activeRoute) }}
    {{ sidebar.link(path('company/profile'), 'fa-building', 'Company profile'|trans, 'profile' == activeRoute) }}
    {{ sidebar.link(path('company/vacancies'), 'fa-briefcase', 'Vacancies'|trans, 'vacancies' == activeRoute) }}
    {{ sidebar.link(path('company/highlights'), 'fa-star', 'Highlights'|trans, 'highlights' == activeRoute) }}
    {{ sidebar.link(path('company/banner'), 'fa-rectangle-ad', 'Banner'|trans, 'banner' == activeRoute) }}
</ul>

<div>
    {{ sidebar.group('Account'|trans) }}
    <ul class="sidebar-list">
        {{ sidebar.link(path('company/representatives'), 'fa-user-group', 'Representatives'|trans, 'representatives' == activeRoute) }}
        {{ sidebar.link(path('company_user_security_index'), 'fa-shield-halved', 'Security'|trans, 'security' == activeRoute) }}
    </ul>
</div>
