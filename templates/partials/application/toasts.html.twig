{% macro toast(message, label) %}
    <div class="toast{{ label ? ' toast-' ~ label : '' }} align-items-center fade" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
        <div class="d-flex">
            <div class="toast-body">{{ message }}</div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="{{ 'Close'|trans }}"></button>
        </div>
    </div>
{% endmacro %}

<div aria-live="polite" aria-atomic="true" class="position-sticky bottom-0">
    <div id="flash-toast-container" class="toast-container bottom-0 end-0 p-3">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                {{ _self.toast(message, label) }}
            {% endfor %}
        {% endfor %}
    </div>
</div>
<template id="realtime-toast-template">
    <div class="toast fade" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="8000">
        <div class="toast-header">
            <span class="realtime-toast-indicator d-inline-block rounded me-2"></span>
            <strong class="realtime-toast-title me-auto"></strong>
            <small class="text-body-secondary">{{ 'just now'|trans }}</small>
            <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="{{ 'Close'|trans }}"></button>
        </div>
        <div class="toast-body"></div>
    </div>
</template>
<script nonce="{{ csp_nonce('script') }}">
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.toast:not(.show)').forEach((toast, index) => {
            setTimeout(() => {
                bootstrap.Toast.getOrCreateInstance(toast).show();
            }, index * 10);
        });
    });
</script>
