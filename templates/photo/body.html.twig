{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'Photos'|trans|page_title }}{{ organ.getName|page_title }}{{ parent() }}{% endblock %}

{# Photos fill the full width of the window, like a regular album. #}
{% block container_class %}container-fluid{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('vendor/photoswipe/dist/photoswipe.min.css') }}">
{% endblock %}

{% block contents %}
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4">
        <h2 class="mb-0">{{ organ.getName }}</h2>
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('association/body', {
            'type': organ.getType.value,
            'abbr': organ.getAbbr,
            'founded': organ.getFoundationDate|date('Y-m-d'),
        }) }}">
            <span class="fa-solid fa-arrow-left me-1"></span>{{ 'Back to the body'|trans }}
        </a>
    </div>

    {# The same viewer as a real album: a photo opens here, and the viewer offers the way to its own album. #}
    {% import 'partials/photo/gallery.html.twig' as gallery %}
    <div {{ gallery.attributes(path('photo/body_manifest', { organ: organ.getId }), false) }}>
        {{ gallery.grid('%name% has not been tagged in any photos yet.'|trans({ '%name%': organ.getName })) }}
    </div>
{% endblock %}
