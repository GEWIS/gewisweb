{% extends 'layout-admin.html.twig' %}

{% set abbr = meeting.type.abbreviation|trans %}

{% block page_title %}{{ (abbr ~ ' ' ~ meeting.number)|page_title }}{{ 'Meetings'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/meetings/index') }}">{{ 'Meetings'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ abbr }} {{ meeting.number }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="mb-0">{{ abbr }} {{ meeting.number }} &middot; {{ meeting.type.label|trans }}</h2>
        <a href="{{ path('meetings/view', {'type': type, 'number': number}) }}" class="btn btn-outline-secondary">
            <span class="fas fa-eye" aria-hidden="true"></span>
            {{ 'View as member'|trans }}
        </a>
    </div>
    <p class="text-muted mb-3">
        {{ meeting.date|format_date('full') }}
        &middot;
        <span class="small">
            <span class="fas fa-rotate" aria-hidden="true"></span>
            {{ 'Date synced from GEWISDB'|trans }}
        </span>
    </p>

    {{ component('Decision:Admin:MeetingManage', {'type': type, 'number': number}) }}

    {% include 'partials/application/confirm-modal.html.twig' %}
{% endblock %}
