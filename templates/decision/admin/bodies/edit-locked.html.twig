{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Already being edited'|trans|page_title }}{{ organ.getAbbr|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/decision/bodies/index') }}">{{ 'Bodies'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/decision/bodies/view', {'organ': organ.getId}) }}">{{ organ.getAbbr }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Already being edited'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8">
            {# Nobody forces this lock open: the other holder is a fellow member of the same body, or the board. #}
            {% include 'partials/application/edit-lock-notice.html.twig' with {
                'lock': lock,
                'subject': 'this page'|trans,
                'backUrl': path('admin/decision/bodies/view', {'organ': organ.getId}),
                'backLabel': 'Go back'|trans,
            } only %}
        </div>
    </div>
{% endblock %}
