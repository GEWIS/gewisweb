{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Review'|trans|page_title }}{{ 'Bodies'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/decision/bodies/index') }}">{{ 'Bodies'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Review'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="row mb-3">
        <div class="col-md-12">
            <h2 class="mb-0">{{ 'Bodies awaiting review'|trans }}</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            {% include 'partials/application/review-queue.html.twig' with {
                'heading': 'Bodies'|trans,
                'rows': rows,
            } only %}
        </div>
    </div>
{% endblock %}
