{% extends 'layout.html.twig' %}

{% block page_title %}{{ organType.pluralLabel|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ page_path(category: 'vereniging', categoryEn: 'association') }}">{{ 'Association'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ organType.pluralLabel|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">{{ organType.pluralLabel|trans }}</h2>
        {% include 'partials/filter-toggle.html.twig' with {
            target: 'body-filters-' ~ organType.value ~ '-now',
        } only %}
    </div>

    {{ component('Decision:BodyOverview', {
        type: organType.value,
        emptyMessage: 'There are currently none of these installed.'|trans,
    }) }}

    <hr class="my-4">

    <h3 class="mb-3">{{ 'Previously installed'|trans }}</h3>
    {{ component('Decision:BodyOverview', {
        type: organType.value,
        abrogated: true,
        dated: true,
        emptyMessage: 'None of these have been abrogated yet.'|trans,
    }) }}
{% endblock %}
