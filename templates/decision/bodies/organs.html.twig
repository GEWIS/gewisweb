{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'Bodies'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">{{ 'Bodies'|trans }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="mb-0">{{ 'Bodies'|trans }}</h2>
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link{{ historical ? '' : ' active' }}" href="{{ path('organs/index') }}">
                    {{ 'Active'|trans }}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link{{ historical ? ' active' : '' }}" href="{{ path('organs/history') }}">
                    {{ 'Abrogated'|trans }}
                </a>
            </li>
        </ul>
    </div>

    <div class="panel">
        <div class="panel-body">
            {% if organs is empty %}
                <p class="text-muted mb-0">{{ 'There is nothing to show here.'|trans }}</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'Abbreviation'|trans }}</th>
                                <th>{{ 'Name'|trans }}</th>
                                <th>{{ 'Type'|trans }}</th>
                                {% if historical %}
                                    <th>{{ 'Abrogation'|trans }}</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for organ in organs %}
                                {% set url = path('organs/view', {'organ': organ.getId}) %}
                                <tr>
                                    <td><a href="{{ url }}"><strong>{{ organ.getAbbr }}</strong></a></td>
                                    <td><a href="{{ url }}">{{ organ.getName }}</a></td>
                                    <td class="text-muted small">{{ organ.getType.label|trans }}</td>
                                    {% if historical %}
                                        <td class="text-muted small">
                                            {{ organ.getAbrogationDate|date('Y-m-d') }}
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
