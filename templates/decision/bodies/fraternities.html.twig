{% extends 'layout.html.twig' %}

{% set plural = enum('App\\Entity\\Decision\\Enums\\OrganTypes').Fraternity.pluralLabel|trans %}

{% block page_title %}{{ plural|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ page_path(category: 'vereniging', categoryEn: 'association') }}">{{ 'Association'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ plural }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h2 class="mb-1">{{ plural }}</h2>
            <p class="text-muted mb-0">
                {{ 'Fraternities are groups of members who share an interest and organise around it themselves.'|trans }}
            </p>
        </div>
        {% include 'partials/filter-toggle.html.twig' with { target: 'body-filters-fraternity-now' } only %}
    </div>

    {{ component('Decision:BodyOverview', {
        type: enum('App\\Entity\\Decision\\Enums\\OrganTypes').Fraternity.value,
        shuffle: true,
        emptyMessage: 'There are currently no fraternities installed.'|trans,
    }) }}

    <hr class="my-4">

    <h3 class="mb-3">{{ 'Retired fraternities'|trans }}</h3>
    {{ component('Decision:BodyOverview', {
        type: enum('App\\Entity\\Decision\\Enums\\OrganTypes').Fraternity.value,
        abrogated: true,
        dated: true,
        emptyMessage: 'No fraternities have retired yet.'|trans,
    }) }}
{% endblock %}
