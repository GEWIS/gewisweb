{% extends 'layout.html.twig' %}

{% block page_title %}{{ organ.getName|page_title }}{{ 'Bodies'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('organs/index') }}">{{ 'Bodies'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ organ.getAbbr }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <h2 class="mb-0">{{ organ.getName }} <small class="text-muted">({{ organ.getAbbr }})</small></h2>
        <a href="{{ path('association/body', {
            'type': organ.getType.value,
            'abbr': organ.getAbbr,
            'founded': organ.getFoundationDate|date('Y-m-d'),
        }) }}" class="btn btn-outline-secondary">
            <span class="fas fa-share-nodes" aria-hidden="true"></span> {{ 'Go to public page'|trans }}
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            {% if members.active is not empty %}
                <h3 class="h5">{{ 'Active members'|trans }}</h3>
                <ul class="list-unstyled">
                    {% for membership in members.active %}
                        <li>
                            <a href="{{ path('members/view', {'member': membership.member.getLidnr}) }}">
                                {{ membership.member.getFullName }}
                            </a>
                            {% if membership.functions is not empty %}
                                <span class="text-muted small">
                                    ({{ membership.functions|join(', ') }})
                                </span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if members.inactive is not empty %}
                <h3 class="h5">{{ 'Inactive members'|trans }}</h3>
                <ul class="list-unstyled">
                    {% for member in members.inactive %}
                        <li>
                            <a href="{{ path('members/view', {'member': member.getLidnr}) }}">{{ member.getFullName }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if members.former is not empty %}
                <h3 class="h5">{{ 'Old members'|trans }}</h3>
                <ul class="list-unstyled">
                    {% for member in members.former %}
                        <li>
                            <a href="{{ path('members/view', {'member': member.getLidnr}) }}">{{ member.getFullName }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="col-md-8">
            <h3 class="h5">{{ 'Organ mutations'|trans }}</h3>
            <ul class="list-unstyled">
                {% for subdecision in organ.getOrderedSubdecisions %}
                    {% set id = subdecision.getMeetingType.value ~ ' ' ~ subdecision.getMeetingNumber ~ '.' ~ subdecision.getDecisionPoint ~ '.' ~ subdecision.getDecisionNumber %}
                    {% set anchor = id ~ '.' ~ subdecision.getSequence %}
                    <li id="{{ anchor|url_encode }}" class="link-permalink-container">
                        <strong class="decision-meeting">
                            <a href="{{ path('meetings/view', {
                                'type': subdecision.getMeetingType.value,
                                'number': subdecision.getMeetingNumber,
                            }) }}">{{ id }}</a>
                        </strong>
                        <span class="decision-content">
                            {{ subdecision.getContentNL }}
                            <a href="#{{ anchor|url_encode }}" class="link-permalink">
                                <span class="fa fa-link" aria-hidden="true"></span>
                            </a>
                        </span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock %}
