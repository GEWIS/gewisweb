{% extends 'layout.html.twig' %}

{% set plural = enum('App\\Entity\\Decision\\Enums\\OrganTypes').Committee.pluralLabel|trans %}

{% block page_title %}{{ plural|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ page_path(category: 'vereniging', categoryEn: 'association') }}">{{ 'Association'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">{{ plural }}</li>
{% endblock %}

{% block contents %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h2 class="mb-1">{{ plural }}</h2>
            <p class="text-muted mb-0">{{ 'GEWIS has many different committees, learn more about them below!'|trans }}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            {% include 'partials/filter-toggle.html.twig' with { target: 'body-filters-committee-now' } only %}
            <a href="{{ path('association/committees/history') }}" class="btn btn-outline-secondary">
                <span class="fas fa-clock-rotate-left" aria-hidden="true"></span> {{ 'Old committees'|trans }}
            </a>
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                <a href="{{ page_path(
                    category: 'commissie',
                    categoryEn: 'committee',
                    subCategory: 'info',
                    subCategoryEn: 'info',
                ) }}" class="btn btn-gewis-primary">
                    {{ 'Information for committees'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {{ component('Decision:BodyOverview', {
        type: enum('App\\Entity\\Decision\\Enums\\OrganTypes').Committee.value,
        emptyMessage: 'There are currently no committees installed.'|trans,
    }) }}
{% endblock %}
