{% extends 'layout.html.twig' %}

{% block page_title %}{{ 'Search decisions'|trans|page_title }}{{ parent() }}{% endblock %}

{% block breadcrumbs %}
    <li class="breadcrumb-item"><a href="{{ path('members/index') }}">{{ 'Members'|trans }}</a></li>
    <li class="breadcrumb-item"><a href="{{ path('meetings/index') }}">{{ 'Meetings'|trans }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ 'Search decisions'|trans }}</li>
{% endblock %}

{% block pre_body %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_title %}{{ 'Search decisions'|trans }}{% endblock %}
        {% block header_subtitle %}
            <p class="page-header-meta mb-0">
                {{ 'Search the decisions accumulated from all past meetings.'|trans }}
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block contents %}
    {{ component('Decision:DecisionSearch') }}
{% endblock %}
