{% extends 'layout.html.twig' %}

{% set meeting = view.meeting %}
{% set abbr = meeting.type.abbreviation|trans %}
{% set statuses = enum('App\\ViewModel\\Decision\\MeetingStatus') %}
{% set isUpcoming = view.status is same as(statuses.Upcoming) %}
{% set isProcessing = view.status is same as(statuses.HeldProcessing) %}
{% set decisionCount = view.decisionEntries|length %}
{% set minutesLatest = view.minutes ? view.minutes.latestVersion : null %}
{% set showDecisionsFirst = decisionCount > 0 %}

{% block page_title %}{{ abbr ~ ' ' ~ meeting.number }}{{ ' - ' }}{{ 'Meetings'|trans|page_title }}{{ parent() }}{% endblock %}

{% block pre_body %}
    {% embed 'partials/application/page-header.html.twig' %}
        {% block header_top %}
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('members/index') }}">{{ 'Members'|trans }}</a></li>
                <li class="breadcrumb-item"><a href="{{ path('meetings/index') }}">{{ 'Meetings'|trans }}</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ abbr }} {{ meeting.number }}</li>
            </ol>
        {% endblock %}
        {% block header_status %}
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                {% include 'partials/decision/meeting-status-badge.html.twig' with {
                    'status': view.status,
                } only %}
                <span class="page-header-meta">{{ meeting.date|format_date('full') }}</span>
            </div>
        {% endblock %}
        {% block header_title %}{{ ordinalNumber }} {{ meeting.type.label|trans }}{% endblock %}
        {% block header_actions %}
            {% if not isVirtual and (view.points is not empty or view.meetingLevelDocuments is not empty) %}
                <a href="{{ path('meetings/documents_zip', {'type': meeting.type.urlToken, 'number': meeting.number}) }}"
                   class="btn btn-outline-gewis-primary">
                    <span class="fas fa-file-zipper" aria-hidden="true"></span>
                    {{ 'Download all documents'|trans }}
                </a>
            {% endif %}
            {% if minutesLatest %}
                <a href="{{ path('meetings/minutes_download', {'version': minutesLatest.id}) }}"
                   class="btn btn-outline-gewis-primary"
                   title="{{ minutesLatest.versionLabel }}{% if minutesLatest.uploadedAt %} &middot; {{ minutesLatest.uploadedAt|format_date('medium') }}{% endif %}">
                    <span class="fas fa-file-pdf" aria-hidden="true"></span>
                    {{ 'Download minutes'|trans }}
                </a>
            {% endif %}
        {% endblock %}
        {% block header_stats %}
            <div class="page-header-stat">
                <span class="page-header-stat-value">{{ view.documentCount }}</span>
                <span class="page-header-stat-label">{{ 'Documents'|trans }}</span>
            </div>
            <div class="page-header-stat">
                <span class="page-header-stat-value">{{ decisionCount > 0 ? decisionCount : '–' }}</span>
                <span class="page-header-stat-label">{{ 'Decisions'|trans }}</span>
            </div>
            <div class="page-header-stat">
                <span class="page-header-stat-value">{{ minutesLatest ? 'Available'|trans : '–' }}</span>
                <span class="page-header-stat-label">{{ 'Minutes'|trans }}</span>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

{% macro document_row(document) %}
    {% set latest = document.latestVersion %}
    {% set versionCount = document.versions|length %}
    {% if latest %}
        <div class="border rounded p-2" data-version-count="{{ versionCount }}">
            <div class="d-flex align-items-center gap-3">
                <span class="fas fa-file-pdf" aria-hidden="true"></span>
                <a href="{{ path('meetings/document_download', {'version': latest.id}) }}" class="flex-grow-1 text-body">
                    <span class="fw-semibold d-block">{{ document.name }}</span>
                    <span class="small text-muted">
                        {{ latest.versionLabel }}
                        {%- if latest.uploadedAt %} &middot; {{ latest.uploadedAt|format_date('medium') }}{% endif %}
                        {%- if versionCount > 1 %} &middot; {{ 'latest of %count% versions'|trans({'%count%': versionCount}) }}{% endif %}
                    </span>
                </a>
                {% if versionCount > 1 %}
                    <button type="button" class="btn btn-sm btn-outline-secondary collapsed"
                            data-bs-toggle="collapse" data-bs-target="#document-history-{{ document.id }}"
                            aria-expanded="false" aria-controls="document-history-{{ document.id }}">
                        {{ 'History'|trans }}
                    </button>
                {% endif %}
                <a href="{{ path('meetings/document_download', {'version': latest.id}) }}" class="text-muted"
                   aria-label="{{ 'Download'|trans }}">
                    <span class="fas fa-download" aria-hidden="true"></span>
                </a>
            </div>
            {% if versionCount > 1 %}
                {% include 'partials/decision/version-history.html.twig' with {
                    'versions': document.versions,
                    'route': 'meetings/document_download',
                    'collapseId': 'document-history-' ~ document.id,
                } only %}
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% block contents %}
    {% if isUpcoming %}
        <div class="alert alert-info d-flex gap-3" role="alert">
            <span class="fas fa-calendar" aria-hidden="true"></span>
            <div>
                <strong>{{ 'This meeting has not taken place yet'|trans }}</strong><br>
                {{ 'Documents are added as they are published, so check back before the meeting. Decisions appear here afterwards.'|trans }}
            </div>
        </div>
    {% elseif isProcessing %}
        <div class="alert alert-warning d-flex gap-3" role="alert">
            <span class="fas fa-clock" aria-hidden="true"></span>
            <div>
                <strong>{{ 'Minutes and decisions have not been published yet'|trans }}</strong><br>
                {{ 'Publishing the outcome of a meeting can take a few weeks, and some meetings take no decisions at all. Documents from the meeting are already available.'|trans }}
            </div>
        </div>
    {% elseif not minutesLatest %}
        <div class="alert alert-warning d-flex gap-3" role="alert">
            <span class="fas fa-clock" aria-hidden="true"></span>
            <div>
                <strong>{{ 'Minutes have not been uploaded yet'|trans }}</strong><br>
                {{ 'The decisions below are final; the full minutes follow once they have been written and approved.'|trans }}
            </div>
        </div>
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-8" data-controller="revision-filter">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 meeting-view-tabs">
                <ul class="nav nav-pills" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {% if not showDecisionsFirst %}active{% endif %}" id="meeting-documents-tab"
                                data-bs-toggle="pill" data-bs-target="#meeting-documents-pane" type="button" role="tab"
                                aria-controls="meeting-documents-pane" aria-selected="{{ not showDecisionsFirst ? 'true' : 'false' }}">
                            {{ 'Documents'|trans }}
                            <span class="badge text-bg-light ms-1">{{ view.documentCount }}</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link {% if showDecisionsFirst %}active{% endif %}" id="meeting-decisions-tab"
                                data-bs-toggle="pill" data-bs-target="#meeting-decisions-pane" type="button" role="tab"
                                aria-controls="meeting-decisions-pane" aria-selected="{{ showDecisionsFirst ? 'true' : 'false' }}">
                            {{ 'Decisions'|trans }}
                            {% if decisionCount > 0 %}
                                <span class="badge text-bg-light ms-1">{{ decisionCount }}</span>
                            {% endif %}
                        </button>
                    </li>
                </ul>
                {% if view.points is not empty or view.meetingLevelDocuments is not empty %}
                    <div class="d-flex gap-2 revision-filter-controls">
                        <button type="button" class="btn btn-sm btn-outline-secondary active"
                                data-revision-filter-target="all" data-action="revision-filter#showAll">
                            {{ 'All documents'|trans }}
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-revision-filter-target="revised" data-action="revision-filter#showRevised">
                            {{ 'Revised only'|trans }}
                        </button>
                    </div>
                {% endif %}
            </div>

            <div class="tab-content">
                <div class="tab-pane fade {% if not showDecisionsFirst %}show active{% endif %} meeting-documents"
                     id="meeting-documents-pane" role="tabpanel" aria-labelledby="meeting-documents-tab" tabindex="0">
                    {% if view.points is not empty or view.meetingLevelDocuments is not empty %}
                        {% for pointView in view.points %}
                            <div class="panel meeting-point-panel">
                                <div class="panel-heading d-flex flex-wrap align-items-baseline gap-2">
                                    <h3 class="flex-grow-1">{{ pointView.point.number }}. {{ pointView.point.title }}</h3>
                                    {% if pointView.decisions is not empty %}
                                        <span class="badge text-bg-light">
                                            {{ '%count% decision|%count% decisions'|trans({'%count%': pointView.decisions|length}) }}
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="panel-body d-flex flex-column gap-2">
                                    {% for document in pointView.documents %}
                                        {{ _self.document_row(document) }}
                                    {% else %}
                                        <span class="text-muted small">{{ 'No documents were uploaded under this agenda point.'|trans }}</span>
                                    {% endfor %}
                                    {% if pointView.decisions is not empty %}
                                        <div class="border-top pt-2 d-flex flex-wrap align-items-center gap-2">
                                            <span class="small text-muted text-uppercase fw-semibold">{{ 'Decisions here'|trans }}</span>
                                            {% for decision in pointView.decisions %}
                                                <span class="badge text-bg-light">{{ abbr }} {{ meeting.number }}.{{ decision.point }}.{{ decision.number }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}

                        {% if view.meetingLevelDocuments is not empty %}
                            <div class="panel meeting-point-panel">
                                <div class="panel-heading">
                                    <h3>{{ view.points is empty ? 'Documents'|trans : 'Other documents'|trans }}</h3>
                                </div>
                                <div class="panel-body d-flex flex-column gap-2">
                                    {% for document in view.meetingLevelDocuments %}
                                        {{ _self.document_row(document) }}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {% if view.unmatchedDecisions is not empty and view.points is not empty %}
                            <div class="panel">
                                <div class="panel-heading">
                                    <h3>{{ 'Raised during the meeting'|trans }}</h3>
                                </div>
                                <div class="panel-body">
                                    <p class="text-muted small mb-2">{{ 'These decisions do not line up with an agenda point above.'|trans }}</p>
                                    {% for decision in view.unmatchedDecisions %}
                                        <div class="d-flex gap-3 {% if not loop.first %}border-top pt-2 mt-2{% endif %}">
                                            <span class="decision-reference text-nowrap">{{ abbr }} {{ meeting.number }}.{{ decision.point }}.{{ decision.number }}</span>
                                            <span>{{ decision.getLocalisedContent(app.request.locale) }}</span>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="panel">
                            <div class="panel-body text-center text-muted py-5">
                                {% if isUpcoming %}
                                    {{ 'No documents have been published for this meeting yet.'|trans }}
                                {% else %}
                                    {{ 'No documents were uploaded for this meeting.'|trans }}
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="tab-pane fade {% if showDecisionsFirst %}show active{% endif %}" id="meeting-decisions-pane"
                     role="tabpanel" aria-labelledby="meeting-decisions-tab" tabindex="0">
                    {% if decisionCount > 0 %}
                        <div class="panel" data-controller="copy" data-copy-done-value="{{ 'Copied!'|trans }}">
                            <div class="panel-heading d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                                <h3>{{ 'All decisions of %meeting%'|trans({'%meeting%': abbr ~ ' ' ~ meeting.number}) }}</h3>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-action="copy#copy" data-copy-target="button">
                                    {{ 'Copy list'|trans }}
                                </button>
                            </div>
                            <div class="panel-body" data-copy-target="source">
                                {% for entry in view.decisionEntries %}
                                    <div class="d-flex gap-3 {% if not loop.first %}border-top pt-2 mt-2{% endif %}"
                                         id="{{ meeting.type.value }} {{ meeting.number }}.{{ entry.decision.point }}.{{ entry.decision.number }}">
                                        <div class="flex-shrink-0 decision-reference text-nowrap">
                                            {{ abbr }} {{ meeting.number }}.{{ entry.decision.point }}.{{ entry.decision.number }}
                                        </div>
                                        <div>
                                            <span {% if entry.decision.isAnnulled %}class="text-decoration-line-through text-muted"{% endif %}>
                                                {{ entry.decision.getLocalisedContent(app.request.locale) }}
                                            </span>
                                            {% if entry.decision.isAnnulled %}
                                                <span class="badge text-bg-danger ms-1">{{ 'Annulled'|trans }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <div class="panel">
                            <div class="panel-body text-center text-muted py-5">
                                {% if isUpcoming %}
                                    {{ 'The meeting takes place on %date%; any decisions taken will be listed here afterwards.'|trans({'%date%': meeting.date|format_date('full')}) }}
                                {% else %}
                                    {{ 'No decisions have been published for this meeting. They may still be processed from the minutes, or this meeting simply took none.'|trans }}
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            {% if view.references is not empty %}
                <div class="panel mt-0">
                    <div class="panel-heading">
                        <h3>{{ 'Reference documents'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        <p class="text-muted small mb-2">{{ 'Not tied to an agenda point; these apply to the meeting as a whole.'|trans }}</p>
                        {% for selection in view.references %}
                            {% set effective = selection.effectiveVersion %}
                            {% if effective %}
                                <a href="{{ path('meetings/reference_download', {'version': effective.id}) }}"
                                   class="d-flex align-items-center gap-2 py-2 text-body {% if not loop.first %}border-top{% endif %}">
                                    <span class="fas fa-file-pdf" aria-hidden="true"></span>
                                    <span class="flex-grow-1">
                                        <span class="fw-semibold d-block">{{ selection.referenceDocument.name }}</span>
                                        <span class="small text-muted">{{ effective.versionLabel }}{% if effective.uploadedAt %} &middot; {{ effective.uploadedAt|format_date('medium') }}{% endif %}</span>
                                    </span>
                                    <span class="fas fa-download text-muted" aria-hidden="true"></span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if nearby is not empty %}
                <div class="panel {% if view.references is empty %}mt-0{% endif %}">
                    <div class="panel-heading">
                        <h3>{{ 'Other meetings'|trans }}</h3>
                    </div>
                    <div class="panel-body">
                        {% for other in nearby %}
                            <a href="{{ path('meetings/view', {'type': other.type.urlToken, 'number': other.number}) }}"
                               class="d-flex align-items-center gap-3 py-2 text-body {% if not loop.first %}border-top{% endif %}">
                                <span class="fw-semibold text-nowrap">{{ other.type.abbreviation|trans }} {{ other.number }}</span>
                                <span class="flex-grow-1 small text-muted">{{ other.date|format_date('full') }}</span>
                                <span class="fas fa-chevron-right text-muted small" aria-hidden="true"></span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
