{% extends 'layout-admin.html.twig' %}

{% set heading = period is null ? 'Open a round'|trans : 'Edit the round'|trans %}

{% block page_title %}{{ heading|page_title }}{{ 'Option calendar'|trans|page_title }}{{ 'Activities'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/index') }}">{{ 'Activities'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/calendar/periods/index') }}">{{ 'Rounds'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ heading }}
    </li>
{% endblock %}

{% block contents %}
    <div class="row justify-content-center">
        <div class="col col-lg-10 col-xl-9">
            <div class="panel">
                <div class="panel-heading">
                    <h3 class="mb-0">{{ heading }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Two windows, and they are not the same: when bodies may hand a proposal in, and which days the activities they propose may fall on. Handing in usually happens well before the quartile itself.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.name) }}
                    <hr>
                    <h4 class="h6 text-muted text-uppercase">{{ 'Handing proposals in'|trans }}</h4>
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.submissionOpensAt) }}</div>
                        <div class="col-md-6">{{ form_row(form.submissionClosesAt) }}</div>
                    </div>
                    <hr>
                    <h4 class="h6 text-muted text-uppercase">{{ 'The days this round covers'|trans }}</h4>
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.startsAt) }}</div>
                        <div class="col-md-6">{{ form_row(form.endsAt) }}</div>
                    </div>
                    <hr>
                    {{ form_row(form.defaultMaxProposals) }}
                    <div class="mt-3 d-flex justify-content-end gap-2">
                        <a href="{{ path('admin/activities/calendar/periods/index') }}" class="btn btn-link">
                            {{ 'Cancel'|trans }}
                        </a>
                        <button type="submit" class="btn btn-gewis-primary">
                            {{ period is null ? 'Open the round'|trans : 'Save'|trans }}
                        </button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
