{% extends 'layout-admin.html.twig' %}

{% set heading = proposal is null ? 'Claim a day'|trans : 'Change your proposal'|trans %}

{% block page_title %}{{ heading|page_title }}{{ 'Option calendar'|trans|page_title }}{{ 'Activities'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/index') }}">{{ 'Activities'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/calendar/index') }}">{{ 'Option calendar'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ heading }}
    </li>
{% endblock %}

{% block contents %}
    <div class="row justify-content-center">
        <div class="col col-lg-10 col-xl-9">
            {{ form_start(form) }}
            {{ form_errors(form) }}

            <div class="panel">
                <div class="panel-heading">
                    <h3 class="mb-0">{{ 'Who and when'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'The round decides which days you may ask for and which board looks at it.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-6">{{ form_row(form.organ) }}</div>
                        <div class="col-md-6">{{ form_row(form.period) }}</div>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading">
                    <h3 class="mb-0">{{ 'What it is'|trans }}</h3>
                </div>
                <div class="panel-body">
                    {{ form_row(form.name) }}
                    {{ form_row(form.description) }}
                </div>
            </div>

            <div class="panel">
                <div class="panel-heading">
                    <h3 class="mb-0">{{ 'Days you want'|trans }}</h3>
                    <p class="text-muted small mb-0">
                        {{ 'Put the day you would rather have first. The board picks one of them.'|trans }}
                    </p>
                </div>
                <div class="panel-body">
                    {{ form_row(form.dateOptions, {'max_entries': constant('App\\Entity\\Activity\\ActivityProposal::MAX_DATE_OPTIONS')}) }}
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="{{ path('admin/activities/calendar/index') }}" class="btn btn-link">
                    {{ 'Cancel'|trans }}
                </a>
                <button type="submit" class="btn btn-gewis-primary">
                    {{ proposal is null ? 'Hand it in'|trans : 'Save'|trans }}
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
