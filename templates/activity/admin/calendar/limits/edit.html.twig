{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ limit.organ.abbr|page_title }}{{ 'Standing exceptions'|trans|page_title }}{{ 'Option calendar'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/index') }}">{{ 'Activities'|trans }}</a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin/activities/calendar/limits/index') }}">{{ 'Standing exceptions'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ limit.organ.abbr }}
    </li>
{% endblock %}

{% block contents %}
    <div class="row justify-content-center">
        <div class="col col-lg-8 col-xl-6">
            <div class="panel">
                <div class="panel-heading">
                    <h3 class="mb-0">{{ limit.organ.abbr }}</h3>
                    <p class="text-muted small mb-0">{{ limit.organ.name }}</p>
                </div>
                <div class="panel-body">
                    {{ form_start(form) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.organ) }}
                    {{ form_row(form.maxProposals) }}
                    <div class="mt-3 d-flex justify-content-end gap-2">
                        <a href="{{ path('admin/activities/calendar/limits/index') }}" class="btn btn-link">
                            {{ 'Cancel'|trans }}
                        </a>
                        <button type="submit" class="btn btn-gewis-primary">{{ 'Save'|trans }}</button>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
