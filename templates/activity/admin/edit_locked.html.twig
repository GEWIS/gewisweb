{% extends 'layout-admin.html.twig' %}

{% block page_title %}{{ 'Activity is being edited'|trans|page_title }}{{ 'Activities'|trans|page_title }}{{ parent() }}{% endblock %}

{% block admin_breadcrumbs %}
    <li class="breadcrumb-item active" aria-current="page">
        <a href="{{ path('admin/activities/index') }}">{{ 'Activities'|trans }}</a>
    </li>
    <li class="breadcrumb-item active" aria-current="page">
        {{ 'Edit'|trans }}
    </li>
{% endblock %}

{% block contents %}
    <div class="row">
        <div class="col-md-8">
            {% include 'partials/application/edit-lock-notice.html.twig' with {
                'lock': lock,
                'subject': 'this activity'|trans,
                'backUrl': path('admin/activities/index'),
                'backLabel': 'Back to overview'|trans,
                'takeOverUrl': path('admin/activities/edit', {'activity': activity.id, 'take': 1}),
            } only %}
        </div>
    </div>
{% endblock %}
